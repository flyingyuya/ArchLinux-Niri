layout {

    focus-ring {
        active-color   "#91ccff"
        inactive-color "#14121c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#91ccff"
        inactive-color "#14121c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#91ccff"
        inactive-color "#004b73"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#91ccff80"
    }
}

recent-windows {
    highlight {
        active-color "#91ccff"
        urgent-color "#ffb4ab"
    }
}
